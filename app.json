{
  "expo": {
    "name": "مسار RTC",
    "slug": "shaker",
    "version": "100.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "org.resala.rtc.masar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00288E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.resala.rtc.masar",
      "buildNumber": "10000",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج إذن الكاميرا لمسح رمز QR الخاص بحضور المحاضرة.",
        "NSPhotoLibraryUsageDescription": "نحتاج إذن الصور لاختيار صورتك الشخصية أو إرفاق مستندات الأعذار.",
        "NSPhotoLibraryAddUsageDescription": "لحفظ الشهادات الرقمية ومشاركتها.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00288E"
      },
      "package": "org.resala.rtc.masar",
      "versionCode": 10000,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج إذن الكاميرا لمسح رمز QR الخاص بحضور المحاضرة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج إذن الوصول للصور لاختيار صورة الأفاتار أو رفع مستند العذر."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00288E"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f48915ef-3b07-4855-9cf8-c2796e5c9c9e"
      }
    },
    "owner": "shaker18ss-team"
  }
}
